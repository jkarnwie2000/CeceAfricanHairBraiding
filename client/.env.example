# Client (Vite) environment variables — copy to client/.env if you need to change them.
# Only variables prefixed with VITE_ reach the browser, so NEVER put secrets here.
# The Stripe SECRET key belongs in server/.env only.

# Where the dev server proxies /api and /uploads (default http://localhost:5000)
VITE_API_PROXY=http://localhost:5000

# Only needed if the API is deployed on a DIFFERENT domain than the website,
# e.g. https://api.ceceafricanhair.com/api  (leave empty when Express serves the client)
VITE_API_URL=
