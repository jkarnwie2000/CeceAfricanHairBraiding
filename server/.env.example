# ─────────────────────────────────────────────────────────────
#  Cece African Hair Braiding — server environment variables
#  Copy this file to `server/.env` and fill in the values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# Where the React app runs (used for CORS + Stripe redirect URLs + email links)
CLIENT_URL=http://localhost:5173
# Public URL of this API server
SERVER_URL=http://localhost:5000

# ── MongoDB ──────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/cece
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cece?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cece

# ── Authentication ───────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Stripe (use TEST keys during development: sk_test_… / pk_test_…) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` (local) or Dashboard → Developers → Webhooks (production): whsec_…
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# ── Pricing rules (calculated on the server, never trusted from the browser) ──
# Sales tax as a decimal (0.089 = 8.9%)
TAX_RATE=0.089
# Flat shipping in dollars, waived when the subtotal reaches the threshold
SHIPPING_FLAT_RATE=7.99
FREE_SHIPPING_THRESHOLD=75

# ── Appointment booking ──────────────────────────────────────
# How many clients can be in the chair at the same time (number of braiders)
BOOKING_CAPACITY=2

# ── Email (any SMTP provider: Gmail app password, SendGrid, Mailgun, Resend, Postmark…) ──
# Leave SMTP_HOST empty in development: emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cece African Hair Braiding <hello@ceceafricanhair.com>"
# Where new-booking / new-order / contact-form notifications are sent
NOTIFY_EMAIL=hello@ceceafricanhair.com

# ── Admin sign-up ────────────────────────────────────────────
# Secret invite code required to create a new admin account at /admin/register.
# Leave EMPTY to turn admin sign-up off (admins can still promote customers in Admin → Customers).
# Generate one with: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_SIGNUP_CODE=

# ── Seed admin account (used by `npm run seed`) ──────────────
ADMIN_NAME=Cece Owner
ADMIN_EMAIL=admin@ceceafricanhair.com
ADMIN_PASSWORD=ChangeMe123!
