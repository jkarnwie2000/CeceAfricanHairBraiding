{
  "name": "cece-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB + Stripe API for Cece African Hair Braiding",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:memory": "node src/dev-memory.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
